# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Environments
.venv/

# Tool caches
.ruff_cache/
.pytest_cache/
.claude/

# Data (large, downloaded/generated separately; regenerable, released via Zenodo).
# Layout: data/{raw,external,interim,processed,release} — see data/README.md.
/data/

# Test subset (symlinks to data/)
tests/bmrb_subset/

# Pipeline output
tmp*/
*.pkl
*.log

# Local tools (not version-controlled)
tools/

# Publication wrapper — separate private repo (tsenoner/trizod-publication);
# holds the manuscript Overleaf clone + submission material. Lives here for
# single-folder convenience but is never tracked by this public repo.
/publication/

# Internal docs — archived under docs/archive/ (mostly ignored; only the
# expert-review record + LACS validation report are tracked). The `dir/*` +
# `!dir/file` idiom is required: a file cannot be re-included if its parent
# directory itself is excluded.
docs/archive/_planning/*
!docs/archive/_planning/suggested_improvements.md
docs/archive/260415/*
!docs/archive/260415/lacs-validation-report.md
docs/pipeline-overview.md

# Per-pair CSP review (regenerable via the binding CSP grid script)
docs/archive/260505/csp_pairs/

# OS
.DS_Store
